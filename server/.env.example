# Local dev points at the postgres in docker-compose.yml.
# On Render, DATABASE_URL is Neon's POOLED string with
# ?pgbouncer=true&connection_limit=1 and DIRECT_URL is the unpooled one,
# because migrations cannot run through pgbouncer.
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker?schema=public"
DIRECT_URL="postgresql://tracker:tracker@localhost:5432/tracker?schema=public"

PORT=4000
CORS_ORIGINS="http://localhost:5173"
ALLOW_VERCEL_PREVIEWS=false
